# ============================================================
# NextStagePro Backend — .env.example
# Copia este archivo como .env y rellena todos los valores
# ============================================================

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ── Base de datos (Neon) ─────────────────────────────────────
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ── Discord OAuth ─────────────────────────────────────────────
# https://discord.com/developers/applications → tu app → OAuth2
DISCORD_CLIENT_ID=TU_CLIENT_ID_DE_DISCORD
DISCORD_CLIENT_SECRET=TU_CLIENT_SECRET_DE_DISCORD
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Obtener con: stripe listen --forward-to localhost:3000/api/subscriptions/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLAYER_PRO=price_...
STRIPE_PRICE_TEAM_PRO=price_...
STRIPE_SUCCESS_URL=http://localhost:4200/subscriptions?success=true
STRIPE_CANCEL_URL=http://localhost:4200/subscriptions?cancelled=true

# ── Email de contacto (QoL — opcional) ───────────────────────
# Si no se configura, los mensajes solo se guardan en BD
# Con Gmail: genera una App Password en myaccount.google.com/security
CONTACT_EMAIL_HOST=smtp.gmail.com
CONTACT_EMAIL_PORT=587
CONTACT_EMAIL_USER=tu@gmail.com
CONTACT_EMAIL_PASS=tu_app_password_de_16_caracteres
CONTACT_EMAIL_TO=contacto@nextstagepro.gg
